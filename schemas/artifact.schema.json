{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "description": "A value the tool supplied because the template did not.\n\nEvery assumption carries its provenance, so a reader can always see the difference\nbetween \"the template says 730 hours\" and \"we assumed 730 hours\".",
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ValueProvenance"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "value",
        "provenance"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "BudgetEvaluation": {
      "additionalProperties": false,
      "description": "How a change measures against one budget.\n\nThe monetary fields are kept apart on purpose. Conflating \"the estimated cost of the\nresources described by this template\" with \"what this application actually costs\" is\nthe fastest way for cost tooling to lose its credibility, so an estimate and an\nactual never share a field.",
      "properties": {
        "baseline_actual_monthly": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "basis": {
          "default": "estimate",
          "title": "Basis",
          "type": "string"
        },
        "budget_id": {
          "title": "Budget Id",
          "type": "string"
        },
        "estimated_delta": {
          "$ref": "#/$defs/Money"
        },
        "estimated_infrastructure_current": {
          "$ref": "#/$defs/Money"
        },
        "estimated_infrastructure_proposed": {
          "$ref": "#/$defs/Money"
        },
        "forecast_monthly": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "headroom": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "maximum_monthly_increase": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "monthly_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope_matched": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope Matched",
          "type": "object"
        },
        "thresholds_crossed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Thresholds Crossed",
          "type": "array"
        },
        "unknown_component_count": {
          "default": 0,
          "title": "Unknown Component Count",
          "type": "integer"
        },
        "utilization_percent": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utilization Percent"
        }
      },
      "required": [
        "budget_id",
        "estimated_infrastructure_current",
        "estimated_infrastructure_proposed",
        "estimated_delta"
      ],
      "title": "BudgetEvaluation",
      "type": "object"
    },
    "ChangeSummary": {
      "additionalProperties": false,
      "description": "How much changed, at a glance.",
      "properties": {
        "added": {
          "default": 0,
          "title": "Added",
          "type": "integer"
        },
        "baseline_resource_count": {
          "default": 0,
          "title": "Baseline Resource Count",
          "type": "integer"
        },
        "heuristically_matched": {
          "default": 0,
          "title": "Heuristically Matched",
          "type": "integer"
        },
        "modified": {
          "default": 0,
          "title": "Modified",
          "type": "integer"
        },
        "no_cost_change": {
          "default": 0,
          "title": "No Cost Change",
          "type": "integer"
        },
        "proposed_resource_count": {
          "default": 0,
          "title": "Proposed Resource Count",
          "type": "integer"
        },
        "removed": {
          "default": 0,
          "title": "Removed",
          "type": "integer"
        },
        "renamed": {
          "default": 0,
          "title": "Renamed",
          "type": "integer"
        },
        "replaced": {
          "default": 0,
          "title": "Replaced",
          "type": "integer"
        },
        "unchanged_count": {
          "default": 0,
          "title": "Unchanged Count",
          "type": "integer"
        },
        "unknown": {
          "default": 0,
          "title": "Unknown",
          "type": "integer"
        }
      },
      "title": "ChangeSummary",
      "type": "object"
    },
    "Confidence": {
      "description": "How much the estimate for a component can be relied upon.\n\nAssigned from the documented table in ``docs/domain-model.md`` and always\naccompanied by human-readable reasons. Never assigned ad hoc.",
      "enum": [
        "UNKNOWN",
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "CostComponent": {
      "additionalProperties": false,
      "description": "One priced dimension of one resource, across both snapshots.",
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "confidence_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Confidence Reasons",
          "type": "array"
        },
        "current_monthly": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimate_type": {
          "$ref": "#/$defs/EstimateType"
        },
        "high": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "low": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "monthly_delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "one_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pricing_dimension": {
          "title": "Pricing Dimension",
          "type": "string"
        },
        "pricing_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PricingSourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposed_monthly": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "purchase_option": {
          "$ref": "#/$defs/PurchaseOption",
          "default": "ON_DEMAND"
        },
        "quantity": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/ResourceKey"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "unknown_inputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnknownInput"
          },
          "title": "Unknown Inputs",
          "type": "array"
        }
      },
      "required": [
        "component_id",
        "service",
        "resource",
        "pricing_dimension",
        "region",
        "estimate_type",
        "confidence"
      ],
      "title": "CostComponent",
      "type": "object"
    },
    "CostReport": {
      "additionalProperties": false,
      "description": "The full estimate: components, totals and everything needed to explain them.",
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "components": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CostComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "region": {
          "default": "",
          "title": "Region",
          "type": "string"
        },
        "totals": {
          "$ref": "#/$defs/CostTotals"
        },
        "unknowns": {
          "$ref": "#/$defs/UnknownSummary"
        }
      },
      "required": [
        "totals"
      ],
      "title": "CostReport",
      "type": "object"
    },
    "CostTotals": {
      "additionalProperties": false,
      "description": "Report-level totals.\n\nThere is deliberately no field that folds unknowns into a number.\n``+$184.27 with 3 unknown components`` is honest; ``+$184.27`` alone is not.",
      "properties": {
        "current_monthly": {
          "$ref": "#/$defs/Money"
        },
        "fixed_delta": {
          "$ref": "#/$defs/Money"
        },
        "monthly_delta": {
          "$ref": "#/$defs/Money"
        },
        "monthly_hours": {
          "default": 730,
          "title": "Monthly Hours",
          "type": "integer"
        },
        "one_time": {
          "$ref": "#/$defs/Money"
        },
        "proposed_monthly": {
          "$ref": "#/$defs/Money"
        },
        "unknown_component_count": {
          "default": 0,
          "title": "Unknown Component Count",
          "type": "integer"
        },
        "usage_based_delta": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "current_monthly",
        "proposed_monthly",
        "monthly_delta",
        "fixed_delta",
        "usage_based_delta",
        "one_time"
      ],
      "title": "CostTotals",
      "type": "object"
    },
    "Currency": {
      "description": "Supported currencies.\n\nThe MVP pricing catalog is USD only. The enum exists so that adding a currency is a\ndata change rather than a refactor of every monetary field.",
      "enum": [
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "EstimateType": {
      "description": "Which pricing model a cost component follows.",
      "enum": [
        "FIXED",
        "USAGE_BASED",
        "COMMITMENT_BASED",
        "TIERED",
        "FREE_TIER_DEPENDENT",
        "DATA_TRANSFER",
        "UNKNOWN"
      ],
      "title": "EstimateType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A concrete thing that caused a policy to match.",
      "properties": {
        "component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component Id"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GateDecision": {
      "additionalProperties": false,
      "description": "The complete, explainable outcome of a gate evaluation.",
      "properties": {
        "budget_evaluations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BudgetEvaluation"
          },
          "title": "Budget Evaluations",
          "type": "array"
        },
        "errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "policy_evaluations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PolicyEvaluation"
          },
          "title": "Policy Evaluations",
          "type": "array"
        },
        "reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "required_approver_groups": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Approver Groups",
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/GateResult"
        },
        "totals": {
          "$ref": "#/$defs/CostTotals"
        },
        "unknowns": {
          "$ref": "#/$defs/UnknownSummary"
        }
      },
      "required": [
        "result",
        "totals"
      ],
      "title": "GateDecision",
      "type": "object"
    },
    "GateResult": {
      "description": "The outcome of a gate evaluation.\n\n``ERROR`` is ranked highest so that ``max()`` produces the correct result, but it is\nnot a policy action: only the engine emits it, when it cannot produce a trustworthy\nanswer. A gate that opens when it is confused is not a gate.",
      "enum": [
        "PASS",
        "WARN",
        "REQUIRE_APPROVAL",
        "BLOCK",
        "ERROR"
      ],
      "title": "GateResult",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "description": "An exact monetary amount in a single currency.",
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "$ref": "#/$defs/Currency",
          "default": "USD"
        }
      },
      "required": [
        "amount"
      ],
      "title": "Money",
      "type": "object"
    },
    "PolicyAction": {
      "description": "What a matched policy asks the gate to do.\n\nA strict subset of :class:`GateResult`: a policy can never produce ``PASS``\n(a policy that matched has something to say) nor ``ERROR`` (that is the engine\nreporting its own failure, not a rule firing).",
      "enum": [
        "WARN",
        "REQUIRE_APPROVAL",
        "BLOCK"
      ],
      "title": "PolicyAction",
      "type": "string"
    },
    "PolicyEvaluation": {
      "additionalProperties": false,
      "description": "The outcome of evaluating one policy, whether or not it matched.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicyAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approver_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approver Group"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "evaluated_inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Evaluated Inputs",
          "type": "object"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "matched": {
          "title": "Matched",
          "type": "boolean"
        },
        "matched_conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Matched Conditions",
          "type": "array"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "MEDIUM"
        }
      },
      "required": [
        "policy_id",
        "matched"
      ],
      "title": "PolicyEvaluation",
      "type": "object"
    },
    "PricingProvenance": {
      "additionalProperties": false,
      "description": "Where the rates in this report came from.",
      "properties": {
        "authoritative": {
          "default": false,
          "title": "Authoritative",
          "type": "boolean"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "catalog_version": {
          "default": "",
          "title": "Catalog Version",
          "type": "string"
        },
        "disclaimer": {
          "default": "",
          "title": "Disclaimer",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "region": {
          "default": "",
          "title": "Region",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "provider"
      ],
      "title": "PricingProvenance",
      "type": "object"
    },
    "PricingSourceRef": {
      "additionalProperties": false,
      "description": "Where a rate came from.\n\nA rate that cannot name its source does not get used. ``retrieved_at`` is when the\nprice was *captured*, not when the tool ran: a report produced today from a catalog\ncaptured months ago must say so.",
      "properties": {
        "authoritative": {
          "default": false,
          "title": "Authoritative",
          "type": "boolean"
        },
        "catalog_version": {
          "default": "",
          "title": "Catalog Version",
          "type": "string"
        },
        "price_id": {
          "default": "",
          "title": "Price Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "region": {
          "default": "",
          "title": "Region",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "required": [
        "provider"
      ],
      "title": "PricingSourceRef",
      "type": "object"
    },
    "PurchaseOption": {
      "description": "Commercial terms under which a rate applies.",
      "enum": [
        "ON_DEMAND",
        "RESERVED",
        "SAVINGS_PLAN",
        "SPOT"
      ],
      "title": "PurchaseOption",
      "type": "string"
    },
    "Reason": {
      "additionalProperties": false,
      "description": "A human-readable statement of why the gate reached its result.",
      "properties": {
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Id"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "MEDIUM"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Reason",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "description": "One thing worth looking at, with the condition under which it applies.",
      "properties": {
        "addressable_monthly": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "MEDIUM"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "title",
        "detail",
        "condition"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RecommendationReport": {
      "additionalProperties": false,
      "description": "Everything worth looking at in one change.",
      "properties": {
        "recommendations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "RecommendationReport",
      "type": "object"
    },
    "ResourceKey": {
      "additionalProperties": false,
      "description": "Identifies a resource within a comparison: a stack plus a logical ID.",
      "properties": {
        "logical_id": {
          "title": "Logical Id",
          "type": "string"
        },
        "stack": {
          "title": "Stack",
          "type": "string"
        }
      },
      "required": [
        "stack",
        "logical_id"
      ],
      "title": "ResourceKey",
      "type": "object"
    },
    "Severity": {
      "description": "How serious a matched policy considers its finding.\n\nSeverity orders the *presentation* of findings. It never affects the decision:\nonly :class:`PolicyAction` does that. A ``low``-severity ``BLOCK`` still blocks.",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
