        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "remedy": {
          "default": "",
          "title": "Remedy",
          "type": "string"
        }
      },
      "required": [
        "name",
        "reason"
      ],
      "title": "UnknownInput",
      "type": "object"
    },
    "UnknownSummary": {
      "additionalProperties": false,
      "description": "What the report could not establish.",
      "properties": {
        "component_count": {
          "default": 0,
          "title": "Component Count",
          "type": "integer"
        },
        "inputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnknownInput"
          },
          "title": "Inputs",
          "type": "array"
        },
        "resource_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Resource Types",
          "type": "array"
        }
      },
      "title": "UnknownSummary",
      "type": "object"
    }
  },
